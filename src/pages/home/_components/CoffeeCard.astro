---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import Button from "../../../components/Button.astro";
import RoastScale from "../../../components/RoastScale.astro";
import { cn } from "../../../lib/cn";

export interface Coffee {
  name: string;
  image: ImageMetadata;
  alt: string;
  price: string;
  origins: string[];
  notes: string[];
  /** Roast level from 0 (lightest) to 100 (darkest), plus its name. */
  roast: { label: string; level: number };
}

interface Props {
  coffee: Coffee;
  /** Extra classes for the bag image, e.g. to size it to a neighbor. */
  imageClass?: string;
}

const { coffee, imageClass } = Astro.props;
---

<article class="flex flex-col gap-8">
  <Image
    src={coffee.image}
    alt={coffee.alt}
    widths={[400, 640, 960, 1280, 1664]}
    sizes="(min-width: 1024px) 25vw, (min-width: 768px) 50vw, 100vw"
    class={cn("aspect-square w-full object-contain select-none", imageClass)}
    draggable="false"
  />

  <div class="flex flex-col gap-6">
    <div class="flex flex-col gap-3">
      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <h3 class="text-xl font-semibold">{coffee.name}</h3>
        <p class="font-mono text-md whitespace-nowrap">{coffee.price}</p>
      </div>
      <p class="font-mono text-sm tracking-widest uppercase">
        {coffee.origins.join(", ")}
      </p>
    </div>

    <div class="flex flex-col gap-3">
      <p class="text-md">Notes: {coffee.notes.join(", ")}</p>
      <RoastScale level={coffee.roast.level} label={coffee.roast.label} />
      <p class="text-md">{coffee.roast.label}</p>
    </div>

    <Button class="self-start">Quick view</Button>
  </div>
</article>
